[Unit]
Description=Update Zelo pre framework with fixed business inputs
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/zelo-pre/auto-update.json

[Service]
Type=oneshot
User=preview
Group=preview
WorkingDirectory=/var/lib/zelo-pre/update
ExecStart=/usr/bin/flock --nonblock /var/lib/zelo-pre/update/job.lock @NODE@ /opt/zelo-pre/scripts/update.mjs --config /etc/zelo-pre/auto-update.json
ExecStopPost=/usr/bin/flock --nonblock /var/lib/zelo-pre/update/job.lock @NODE@ /opt/zelo-pre/scripts/update.mjs --config /etc/zelo-pre/auto-update.json --cleanup
TimeoutStartSec=30min
TimeoutStopSec=30
KillMode=control-group
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zelo-pre/update /var/lib/zelo-pre/data /var/lib/zelo-pre/backups /opt/zelo-pre/releases /opt/zelo-pre/state
Nice=19
CPUQuota=100%
MemoryHigh=3G
MemoryMax=3584M
IOSchedulingClass=idle
IOWeight=10
Environment=NODE_OPTIONS=--max-old-space-size=2816
LimitCORE=0

