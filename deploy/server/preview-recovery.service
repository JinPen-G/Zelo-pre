[Unit]
Description=Recover interrupted Zelo pre deployment before startup
After=network.target
Before=preview.service
ConditionPathExists=/opt/zelo-pre/state/transaction.json

[Service]
Type=oneshot
User=preview
Group=preview
UMask=0077
ExecStart=@NODE@ /opt/zelo-pre/scripts/deploy.mjs recover --boot --config /etc/zelo-pre/deploy.json
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
